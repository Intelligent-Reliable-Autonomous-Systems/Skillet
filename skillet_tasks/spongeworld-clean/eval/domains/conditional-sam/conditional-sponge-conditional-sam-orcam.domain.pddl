(define (domain sponge-alpha2-domain)
    (:requirements :strips :typing :negative-preconditions :disjunctive-preconditions :equality :conditional-effects :universal-preconditions)
    (:types
        object_ - object
        surface item - object_
        sponge can spill - item
        table plate target bin - surface
    )
    (:predicates 
        (graspable ?m - item)
        (deformable ?m - item)
        (supportable ?m - surface)
        (wipeable ?m - item)
        (wet ?b - item)
        (dirty ?b - surface)
        (upright ?b - can)
        (on ?b - object_ ?s - surface)
        (grasping ?b - item)
        (obstructed ?b - surface)
        (gripper-full)
    )
    (:action pick
        :parameters ( ?target - item ?support - surface)
        :precondition (and
            (graspable ?target)
            (not (grasping ?target))
            (not (gripper-full))
            (not (wipeable ?target))
            (obstructed ?support)
            (on ?target ?support)
            (supportable ?support)
            (or (deformable ?target) (and (not (deformable ?target)) (not (wet ?target))))
        )
        :effect (and
            (grasping ?target)
            (gripper-full)
            (not (obstructed ?support))
            (not (on ?target ?support))
        )
    )
    (:action wipe
        :parameters ( ?grasped - item ?mess - item ?target - surface)
        :precondition (and
            (deformable ?grasped)
            (graspable ?grasped)
            (grasping ?grasped)
            (gripper-full)
            (not (deformable ?mess))
            (not (graspable ?mess))
            (not (grasping ?mess))
            (not (on ?grasped ?target))
            (not (wet ?mess))
            (not (wipeable ?grasped))
            (supportable ?target)
            (wipeable ?mess)
            (forall (?c - can)
 (not (wet ?c)))
            (forall (?c - can)
 (or (deformable ?c) (and (graspable ?c) (not (deformable ?c)) (not (grasping ?c)) (not (upright ?c)) (not (wipeable ?c)) (or (not (on ?c ?target)) (obstructed ?target)))))
            (or (and (dirty ?target) (on ?mess ?target)) (and (not (dirty ?target)) (not (on ?mess ?target))))
            (or (not (wet ?grasped)) (and (dirty ?target) (on ?mess ?target) (wet ?grasped)))
            (not (= ?grasped ?mess))
        )
        :effect (and
            (when
                (and (dirty ?target) (obstructed ?target) (on ?mess ?target))
                (not (obstructed ?target))
            )
            (when
                (and (dirty ?target) (on ?mess ?target))
                (not (dirty ?target))
            )
            (when
                (and (dirty ?target) (on ?mess ?target))
                (not (on ?mess ?target))
            )
            (forall (?c - can)
                (when
                    (and (graspable ?c) (not (deformable ?c)) (not (grasping ?c)) (not (upright ?c)) (not (wet ?c)) (not (wipeable ?c)) (obstructed ?target) (on ?c ?target))
                    (not (on ?c ?target))
                )
            )
            (forall (?c - can)
                (on ?c ?target)
            )
        )
    )
    (:action place
        :parameters ( ?grasped - item ?target - surface)
        :precondition (and
            (graspable ?grasped)
            (grasping ?grasped)
            (gripper-full)
            (not (on ?grasped ?target))
            (not (wipeable ?grasped))
            (supportable ?target)
            (or (not (wet ?grasped)) (and (deformable ?grasped) (not (obstructed ?target)) (wet ?grasped)))
        )
        :effect (and
            (not (grasping ?grasped))
            (not (gripper-full))
            (on ?grasped ?target)
            (when
                (not (obstructed ?target))
                (obstructed ?target)
            )
        )
    )
)
