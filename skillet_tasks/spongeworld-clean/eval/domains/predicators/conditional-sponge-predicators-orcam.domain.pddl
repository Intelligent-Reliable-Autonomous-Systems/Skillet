    (:action pick__0
        :parameters ( ?target - item ?support - surface)
        :precondition (and
            (graspable ?target)
            (obstructed ?support)
            (on ?target ?support)
            (supportable ?support)
        )
        :effect (and
            (grasping ?target)
            (gripper-full)
            (not (obstructed ?support))
            (not (on ?target ?support))
        )
    )
