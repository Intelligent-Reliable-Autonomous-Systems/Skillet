(define (domain simple-blocks-pick-place-v1-domain)
    (:requirements :strips :typing :negative-preconditions :disjunctive-preconditions :equality :conditional-effects :universal-preconditions)
    (:types
        surface location - object
        table target block - surface
    )
    (:predicates
        (loc-above ?l1 - location ?l2 - location)
        (wooden ?b - surface)
        (plastic ?b - surface)
        (at-loc ?s - surface ?l - location)
        (grasping ?b - block)
        (on ?b - surface ?s - surface)
        (not-grid-aligned ?b - surface)
        (gripper-full)
        (two-held)
        (three-held)
        (obstructed-above ?l - location)
    )
    (:action pick-block
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (loc-above ?targetloc ?supportloc)
            (not (at-loc ?support ?targetloc))
            (not (at-loc ?target ?supportloc))
            (not (grasping ?target))
            (not (gripper-full))
            (not (loc-above ?supportloc ?targetloc))
            (not (not-grid-aligned ?support))
            (not (not-grid-aligned ?target))
            (not (obstructed-above ?targetloc))
            (not (on ?support ?target))
            (not (three-held))
            (not (two-held))
            (obstructed-above ?supportloc)
            (on ?target ?support)
            (or (not (plastic ?support)) (not (wooden ?support)))
            (or (not (plastic ?target)) (not (wooden ?target)))
            (or (plastic ?target) (wooden ?target))
            (forall (?b - block)
 (or (at-loc ?b ?supportloc) (and (not (at-loc ?b ?supportloc)) (not (at-loc ?b ?targetloc)) (not (grasping ?b)) (not (not-grid-aligned ?b)) (not (on ?b ?target)) (not (on ?target ?b)) (or (not (on ?b ?support)) (not (on ?support ?b))) (or (not (plastic ?b)) (not (wooden ?b))) (or (plastic ?b) (wooden ?b)))))
            (forall (?l - location)
 (or (not (loc-above ?supportloc ?l)) (and (loc-above ?supportloc ?l) (not (at-loc ?support ?l)) (not (at-loc ?target ?l)) (not (loc-above ?l ?supportloc)) (not (loc-above ?l ?targetloc)) (not (loc-above ?targetloc ?l)) (obstructed-above ?l))))
            (not (= ?targetloc ?supportloc))
        )
        :effect (and
            (grasping ?target)
            (gripper-full)
            (not (at-loc ?target ?targetloc))
            (not (obstructed-above ?supportloc))
            (not (on ?target ?support))
            (when
                (and (not (wooden ?target)) (plastic ?support) (plastic ?target))
                (two-held)
            )
            (when
                (and (not (wooden ?target)) (plastic ?support) (plastic ?target))
                (not (at-loc ?support ?supportloc))
            )
            (forall (?l - location)
                (obstructed-above ?l)
            )
            (forall (?l - location)
                (not (obstructed-above ?l))
            )
            (forall (?l - location)
                (at-loc ?target ?l)
            )
            (forall (?l - location)
                (when
                    (and (at-loc ?target ?l) (not (at-loc ?support ?l)) (not (loc-above ?l ?supportloc)) (not (loc-above ?l ?targetloc)) (not (loc-above ?supportloc ?l)) (not (loc-above ?targetloc ?l)) (not (obstructed-above ?l)) (plastic ?support))
                    (not (at-loc ?target ?l))
                )
            )
            (forall (?b - block)
                (not (on ?support ?b))
            )
            (forall (?b - block)
                (on ?b ?target)
            )
        )
    )
    (:action place-block
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location)
        :precondition (and
            (at-loc ?target ?targetloc)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (not (at-loc ?grasped ?freeloc))
            (not (at-loc ?grasped ?targetloc))
            (not (at-loc ?target ?freeloc))
            (not (loc-above ?targetloc ?freeloc))
            (not (not-grid-aligned ?grasped))
            (not (not-grid-aligned ?target))
            (not (obstructed-above ?freeloc))
            (not (obstructed-above ?targetloc))
            (not (on ?grasped ?target))
            (not (on ?target ?grasped))
            (not (three-held))
            (or (not (plastic ?grasped)) (not (wooden ?grasped)))
            (or (not (plastic ?target)) (not (wooden ?target)))
            (or (not (two-held)) (not (wooden ?grasped)))
            (or (not (two-held)) (plastic ?grasped))
            (or (plastic ?grasped) (wooden ?grasped))
            (forall (?b - block)
 (or (not (on ?grasped ?b)) (and (not (at-loc ?b ?freeloc)) (not (at-loc ?b ?targetloc)) (not (grasping ?b)) (not (not-grid-aligned ?b)) (not (on ?b ?grasped)) (not (on ?b ?target)) (not (on ?target ?b)) (not (wooden ?b)) (on ?grasped ?b) (plastic ?b))))
            (forall (?l - location)
 (or (loc-above ?freeloc ?l) (and (not (at-loc ?grasped ?l)) (not (loc-above ?freeloc ?l)) (not (loc-above ?l ?targetloc)) (or (not (at-loc ?target ?l)) (not (loc-above ?l ?freeloc))) (or (not (at-loc ?target ?l)) (not (loc-above ?targetloc ?l))) (or (not (loc-above ?l ?freeloc)) (not (loc-above ?targetloc ?l))) (or (not (loc-above ?l ?freeloc)) (not (obstructed-above ?l))) (or (not (loc-above ?targetloc ?l)) (obstructed-above ?l)))))
            (not (= ?freeloc ?targetloc))
        )
        :effect (and
            (at-loc ?grasped ?freeloc)
            (not (at-loc ?target ?targetloc))
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?targetloc)
            (on ?grasped ?target)
            (when
                (and (not (wooden ?grasped)) (plastic ?grasped) (two-held))
                (not (two-held))
            )
            (when
                (and (not (wooden ?grasped)) (plastic ?grasped) (two-held))
                (obstructed-above ?freeloc)
            )
            (forall (?l - location)
                (at-loc ?grasped ?l)
            )
            (forall (?l - location)
                (at-loc ?target ?l)
            )
            (forall (?l - location)
                (obstructed-above ?l)
            )
            (forall (?l - location)
                (not (obstructed-above ?l))
            )
            (forall (?b - block)
                (on ?b ?target)
            )
            (forall (?b - block)
                (on ?b ?grasped)
            )
            (forall (?b - block)
                (not (on ?target ?b))
            )
            (forall (?b - block)
                (when
                    (and (not (at-loc ?b ?freeloc)) (not (at-loc ?b ?targetloc)) (not (grasping ?b)) (not (not-grid-aligned ?b)) (not (on ?b ?grasped)) (not (on ?b ?target)) (not (on ?target ?b)) (not (wooden ?b)) (on ?grasped ?b) (plastic ?b) (two-held))
                    (at-loc ?b ?freeloc)
                )
            )
        )
    )
)
