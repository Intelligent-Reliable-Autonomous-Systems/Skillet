(define (domain simple-blocks-pick-place-v1-domain)
    (:requirements :strips :typing)
    (:types
        surface location - object
        table target block - surface
    )
    (:predicates 
        (loc-above ?l1 - location ?l2 - location)
        (wooden ?b - surface)
        (plastic ?b - surface)
        (at-loc ?s - surface ?l - location)
        (grasping ?b - block)
        (on ?b - surface ?s - surface)
        (not-grid-aligned ?b - surface)
        (gripper-full)
        (two-held)
        (three-held)
        (obstructed-above ?l - location)
    )
    (:action pick-block__0
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - table ?x1 - block ?x2 - location ?x3 - location)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (at-loc ?x0 ?x2)
            (at-loc ?x1 ?x3)
            (loc-above ?supportloc ?x3)
            (loc-above ?targetloc ?supportloc)
            (loc-above ?x3 ?x2)
            (obstructed-above ?supportloc)
            (obstructed-above ?x2)
            (obstructed-above ?x3)
            (on ?support ?x1)
            (on ?target ?support)
            (on ?x1 ?x0)
            (plastic ?support)
            (plastic ?target)
            (plastic ?x1)
        )
        :effect (and
            (not (at-loc ?support ?supportloc))
            (not (at-loc ?target ?targetloc))
            (at-loc ?x1 ?targetloc)
            (not (at-loc ?x1 ?x3))
            (grasping ?target)
            (gripper-full)
            (not (obstructed-above ?x2))
            (not (obstructed-above ?x3))
            (not (on ?x1 ?x0))
            (two-held)
        )
    )
    (:action pick-block__1
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - table ?x1 - location)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (at-loc ?x0 ?x1)
            (loc-above ?supportloc ?x1)
            (loc-above ?targetloc ?supportloc)
            (obstructed-above ?supportloc)
            (obstructed-above ?x1)
            (on ?support ?x0)
            (on ?target ?support)
            (plastic ?support)
            (plastic ?target)
        )
        :effect (and
            (not (at-loc ?support ?supportloc))
            (not (at-loc ?target ?targetloc))
            (grasping ?target)
            (gripper-full)
            (not (obstructed-above ?supportloc))
            (not (obstructed-above ?x1))
            (not (on ?support ?x0))
            (two-held)
        )
    )
    (:action pick-block__2
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - block ?x1 - location)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (at-loc ?x0 ?x1)
            (loc-above ?supportloc ?x1)
            (loc-above ?targetloc ?supportloc)
            (obstructed-above ?supportloc)
            (obstructed-above ?x1)
            (on ?support ?x0)
            (on ?target ?support)
            (plastic ?support)
            (plastic ?target)
            (wooden ?x0)
        )
        :effect (and
            (not (at-loc ?support ?supportloc))
            (not (at-loc ?target ?targetloc))
            (grasping ?target)
            (gripper-full)
            (not (obstructed-above ?supportloc))
            (not (obstructed-above ?x1))
            (not (on ?support ?x0))
            (two-held)
        )
    )
    (:action pick-block__3
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (loc-above ?targetloc ?supportloc)
            (obstructed-above ?supportloc)
            (on ?target ?support)
        )
        :effect (and
            (not (at-loc ?target ?targetloc))
            (grasping ?target)
            (gripper-full)
            (not (obstructed-above ?supportloc))
            (not (on ?target ?support))
        )
    )
    (:action pick-block__4
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - location ?x1 - location ?x2 - block)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (at-loc ?x2 ?x0)
            (loc-above ?supportloc ?x0)
            (loc-above ?targetloc ?supportloc)
            (loc-above ?x0 ?x1)
            (obstructed-above ?supportloc)
            (obstructed-above ?x0)
            (obstructed-above ?x1)
            (on ?support ?x2)
            (on ?target ?support)
            (plastic ?support)
            (plastic ?target)
            (plastic ?x2)
        )
        :effect (and
            (not (at-loc ?support ?supportloc))
            (not (at-loc ?target ?targetloc))
            (at-loc ?x2 ?targetloc)
            (not (at-loc ?x2 ?x0))
            (grasping ?target)
            (gripper-full)
            (not (obstructed-above ?x0))
            (not (obstructed-above ?x1))
            (two-held)
        )
    )
    (:action pick-block__5
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - location ?x1 - block)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (loc-above ?targetloc ?supportloc)
            (obstructed-above ?supportloc)
            (obstructed-above ?x0)
            (on ?target ?support)
            (plastic ?target)
            (plastic ?x1)
        )
        :effect (and
            (not (at-loc ?target ?targetloc))
            (at-loc ?target ?x0)
            (not (obstructed-above ?supportloc))
            (on ?x1 ?target)
        )
    )
    (:action pick-block__6
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - location)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (at-loc ?target ?x0)
            (loc-above ?targetloc ?supportloc)
            (obstructed-above ?supportloc)
            (on ?target ?support)
            (plastic ?support)
            (wooden ?target)
        )
        :effect (and
            (not (at-loc ?target ?targetloc))
            (not (at-loc ?target ?x0))
            (grasping ?target)
            (gripper-full)
            (not (obstructed-above ?supportloc))
            (not (on ?target ?support))
        )
    )
    (:action pick-block__7
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - location ?x1 - location ?x2 - location)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (loc-above ?targetloc ?supportloc)
            (loc-above ?x1 ?x0)
            (obstructed-above ?supportloc)
            (on ?target ?support)
            (plastic ?target)
        )
        :effect (and
            (not (at-loc ?target ?targetloc))
            (at-loc ?target ?x1)
            (at-loc ?target ?x2)
            (not (obstructed-above ?supportloc))
            (obstructed-above ?x0)
            (not (on ?target ?support))
        )
    )
    (:action pick-block__8
        :parameters ( ?target - block ?support - surface ?targetloc - location ?supportloc - location ?x0 - block)
        :precondition (and
            (at-loc ?support ?supportloc)
            (at-loc ?target ?targetloc)
            (loc-above ?targetloc ?supportloc)
            (obstructed-above ?supportloc)
            (on ?target ?support)
            (plastic ?target)
            (wooden ?x0)
        )
        :effect (and
            (not (at-loc ?target ?targetloc))
            (not (obstructed-above ?supportloc))
            (not (on ?target ?support))
            (on ?x0 ?target)
        )
    )
    (:action place-block__0
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - location ?x1 - location ?x2 - block ?x3 - location ?x4 - block)
        :precondition (and
            (at-loc ?target ?targetloc)
            (at-loc ?x2 ?x3)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (loc-above ?x0 ?freeloc)
            (loc-above ?x3 ?x1)
            (obstructed-above ?x1)
            (on ?grasped ?x4)
            (on ?x4 ?x2)
            (plastic ?grasped)
            (plastic ?x2)
            (plastic ?x4)
            (two-held)
            (wooden ?target)
        )
        :effect (and
            (at-loc ?x2 ?freeloc)
            (not (at-loc ?x2 ?x3))
            (at-loc ?x4 ?x0)
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?freeloc)
            (obstructed-above ?targetloc)
            (not (obstructed-above ?x1))
            (on ?x2 ?target)
            (not (two-held))
        )
    )
    (:action place-block__1
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - location ?x1 - block)
        :precondition (and
            (at-loc ?target ?targetloc)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (loc-above ?x0 ?freeloc)
            (on ?grasped ?x1)
            (plastic ?grasped)
            (plastic ?x1)
            (two-held)
        )
        :effect (and
            (at-loc ?grasped ?x0)
            (at-loc ?x1 ?freeloc)
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?freeloc)
            (obstructed-above ?targetloc)
            (on ?x1 ?target)
            (not (two-held))
        )
    )
    (:action place-block__2
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location)
        :precondition (and
            (at-loc ?target ?targetloc)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
        )
        :effect (and
            (at-loc ?grasped ?freeloc)
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?targetloc)
            (on ?grasped ?target)
        )
    )
    (:action place-block__3
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - location ?x1 - location ?x2 - location ?x3 - block ?x4 - location ?x5 - block)
        :precondition (and
            (at-loc ?target ?targetloc)
            (at-loc ?x3 ?x2)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (loc-above ?x1 ?freeloc)
            (loc-above ?x2 ?x0)
            (loc-above ?x4 ?x1)
            (obstructed-above ?x0)
            (on ?grasped ?x5)
            (on ?x5 ?x3)
            (plastic ?grasped)
            (plastic ?x3)
            (plastic ?x5)
            (two-held)
        )
        :effect (and
            (at-loc ?grasped ?x4)
            (at-loc ?x3 ?freeloc)
            (not (at-loc ?x3 ?x2))
            (at-loc ?x5 ?x1)
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?freeloc)
            (obstructed-above ?targetloc)
            (not (obstructed-above ?x0))
            (obstructed-above ?x1)
            (not (two-held))
        )
    )
    (:action place-block__4
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - location ?x1 - location ?x2 - location ?x3 - location ?x4 - block ?x5 - block)
        :precondition (and
            (at-loc ?target ?targetloc)
            (at-loc ?x4 ?x3)
            (at-loc ?x5 ?x2)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (loc-above ?x1 ?x0)
            (loc-above ?x2 ?x3)
            (obstructed-above ?x3)
            (on ?x4 ?target)
            (on ?x5 ?x4)
            (plastic ?x4)
            (plastic ?x5)
            (wooden ?grasped)
        )
        :effect (and
            (at-loc ?grasped ?freeloc)
            (at-loc ?x5 ?x1)
            (not (at-loc ?x5 ?x2))
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?targetloc)
            (obstructed-above ?x0)
            (not (obstructed-above ?x3))
            (on ?grasped ?target)
            (not (on ?x5 ?x4))
        )
    )
    (:action place-block__5
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location)
        :precondition (and
            (at-loc ?target ?targetloc)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (wooden ?grasped)
        )
        :effect (and
            (at-loc ?grasped ?freeloc)
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?targetloc)
        )
    )
    (:action place-block__6
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - block)
        :precondition (and
            (at-loc ?target ?targetloc)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (plastic ?grasped)
            (wooden ?x0)
        )
        :effect (and
            (at-loc ?grasped ?freeloc)
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?targetloc)
            (on ?grasped ?target)
            (on ?x0 ?grasped)
        )
    )
    (:action place-block__7
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - location)
        :precondition (and
            (at-loc ?target ?targetloc)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (plastic ?target)
            (wooden ?grasped)
        )
        :effect (and
            (at-loc ?grasped ?freeloc)
            (at-loc ?grasped ?x0)
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?targetloc)
            (on ?grasped ?target)
        )
    )
    (:action place-block__8
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - location ?x1 - location ?x2 - location ?x3 - location ?x4 - block ?x5 - location ?x6 - block ?x7 - location ?x8 - block)
        :precondition (and
            (at-loc ?target ?targetloc)
            (at-loc ?target ?x2)
            (at-loc ?x4 ?x7)
            (at-loc ?x6 ?x0)
            (at-loc ?x8 ?x5)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (loc-above ?x0 ?x2)
            (loc-above ?x3 ?x1)
            (loc-above ?x7 ?x5)
            (obstructed-above ?x2)
            (obstructed-above ?x5)
            (on ?x4 ?x8)
            (on ?x6 ?target)
            (on ?x8 ?target)
            (plastic ?x4)
            (plastic ?x8)
            (wooden ?grasped)
            (wooden ?x6)
        )
        :effect (and
            (at-loc ?x4 ?x3)
            (not (at-loc ?x4 ?x7))
            (not (at-loc ?x6 ?x0))
            (not (grasping ?grasped))
            (not (gripper-full))
            (obstructed-above ?x1)
            (not (obstructed-above ?x2))
            (not (obstructed-above ?x5))
            (on ?grasped ?target)
            (not (on ?x4 ?x8))
        )
    )
    (:action place-block__9
        :parameters ( ?grasped - block ?target - surface ?freeloc - location ?targetloc - location ?x0 - location ?x1 - block)
        :precondition (and
            (at-loc ?target ?targetloc)
            (grasping ?grasped)
            (gripper-full)
            (loc-above ?freeloc ?targetloc)
            (loc-above ?x0 ?freeloc)
            (on ?grasped ?x1)
            (plastic ?grasped)
            (plastic ?x1)
