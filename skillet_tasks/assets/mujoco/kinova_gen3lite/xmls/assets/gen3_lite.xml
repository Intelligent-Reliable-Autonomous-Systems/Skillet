<mujoco model="gen3_lite_gripper_position">
  <compiler angle="radian" meshdir="assets"/>
  <option integrator="implicitfast"/>

  <default>
    <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="kinova_dark"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" contype="1" conaffinity="1"/>
      </default>
      <default class="large_actuator">
        <position kp="2000" kv="50" forcerange="-32 32"/>
      </default>
      <default class="small_actuator">
        <position kp="1000" kv="30" forcerange="-9 9"/>
      </default>
      <!-- Arm joint classes -->
      <default class="arm_joint">
        <joint armature="0.1" frictionloss="1.0"/>
      </default>
    <!-- Gen3Lite 2F gripper classes (matches mujoco_menagerie exactly) -->
    <default class="gen3lite_2f">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>

      <!--TODO(Will) adjust these values as needed-->
      <joint axis="1 0 0"/>
      <default class="driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001" stiffness="0.8" springref="2.62" damping="0.00125"/>
      </default>
      <default class="coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>

      <default class="gripper_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="gripper_collision">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375" friction="3.0"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375" friction="3.0"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
    <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
  </default>

  <asset>
    <material name="kinova_dark" rgba="0.75294 0.75294 0.75294 1"/>
    <material name="kinova_gray" rgba="0.4 0.4 0.4 1"/>
    <material name="metal" rgba="0.58 0.58 0.58 1"/>
    <material name="silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="black" rgba="0.149 0.149 0.149 1"/>

    <!-- Kinova arm meshes -->
    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="shoulder_link" file="shoulder_link.stl"/>
    <mesh name="arm_link" file="arm_link.stl"/>
    <mesh name="forearm_link" file="forearm_link.stl"/>
    <mesh name="lower_wrist_link" file="lower_wrist_link.stl"/>
    <mesh name="upper_wrist_link" file="upper_wrist_link.stl"/>

    <!-- Gen3Lite 2F Gripper Meshes -->
    <mesh name="gripper_base_link" file="gripper_base_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_finger_prox_link" file="right_finger_prox_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_finger_prox_link" file="left_finger_prox_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_finger_dist_link" file="right_finger_dist_link_finger_dist_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_finger_dist_link" file="left_finger_dist_link.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
  <!--TODO(Will) Convert initeria IXX to inertial POS/Quat tags-->
    <body name="base_link">
      <initerial pos="" quat="" mass="1.14608471"
      diaginertia="" />
      <origin rpy="0 0 0" xyz="0.00244324 0.00015573 0.08616742"/>
      <inertia ixx="0.00335854" ixy="3.9E-07" ixz="0.00010989" iyy="0.003311" iyz="1.91E-06" izz="0.00077158"/>
      <geom class="visual" mesh="base_link"/>
      <geom class="collision" mesh="base_link"/>
      <body name="shoulder_link" pos="" quat="">
        <initerial pos="" quat="" mass="0.95974404"
        diaginertia="" />
        <origin rpy="0 0 0" xyz="2.477E-05 0.02213531 0.09937686"/>
        <inertia ixx="0.00165947" ixy="2E-08" ixz="3.6E-07" iyy="0.00140355" iyz="0.00034927" izz="0.00089493"/>
        <joint name="joint_1" class="arm_joint" range="-2.69 2.69"/>
        <geom class="visual" mesh="shoulder_link"/>
        <geom class="collision" mesh="shoulder_link"/>
        <body name="arm_link" pos="" quat="">
          <initerial pos="" quat="" mass="1.17756164"
          diaginertia="" />
          <origin rpy="0 0 0" xyz="0.02998299 0.21154808 0.0453031"/>
          <inertia ixx="0.01149277" ixy="1E-06" ixz="1.6E-07" iyy="0.00102851" iyz="0.00140765" izz="0.01133492"/>
          <joint name="joint_2" class="arm_joint" range="-2.69 2.69"/>
          <geom class="visual" mesh="arm_link"/>
          <geom class="collision" mesh="arm_link"/>
          <body name="forearm_link" pos="" quat=""/>
            <initerial pos="" quat="" mass="0.59767669"
            diaginertia="" />
            <origin rpy="0 0 0" xyz="0.0301559 0.09502206 0.0073555"/>
            <inertia ixx="0.00163256" ixy="7.11E-06" ixz="1.54E-06" iyy="0.00029798" iyz="9.587E-05" izz="0.00169091"/>
            <joint name="joint_3" class="arm_joint" range="-2.69 2.69"/>
            <geom class="visual" mesh="forearm_link"/>
            <geom class="collision" mesh="forearm_link"/>
            <body name="lower_wrist_link" pos="" quat=""/>
              <initerial pos="" quat="" mass="0.52693412"
              diaginertia="" />
              <origin rpy="0 0 0" xyz="0.00575149 0.01000443 0.08719207"/>
              <inertia ixx="0.00069098" ixy="2.4E-07" ixz="0.00016483" iyy="0.00078519" iyz="7.4E-07" izz="0.00034115"/>
              <joint name="joint_4" class="arm_joint" range="-2.59 2.59"/>
              <geom class="visual" mesh="lower_wrist_link"/>
              <geom class="collision" mesh="lower_wrist_link"/>
              <body name="upper_wrist_link" pos="" quat=""/>
                <initerial pos="" quat="" mass="0.58097325"
                diaginertia="" />
                <origin rpy="0 0 0" xyz="0.08056517 0.00980409 0.01872799"/>
                <inertia ixx="0.00021268" ixy="5.21E-06" ixz="2.91E-06" iyy="0.00106371" iyz="1.1E-07" izz="0.00108465"/>
                <joint name="joint_5" class="arm_joint" range="-2.57 2.57"/>
                <geom class="visual" mesh="upper_wrist_link"/>
                <geom class="collision" mesh="upper_wrist_link"/>   

                <!-- End effector link (180 deg rotation around X to match URDF) -->
                <body name="end_effector_link" pos="" quat="" childclass="gen3lite_2f">
                  <joint name="joint_6" class="arm_joint" range="-2.59 2.59"/>
                  
                  <body name="gripper_base_link" pos="" quat=""/>
                    <initerial pos="" quat="" mass="0.1395"
                    diaginertia="" />
                    <origin rpy="0 0 0" xyz="4.03E-06 1.08E-05 0.041397"/>
                    <inertia ixx="0.00011614" ixy="1E-08" ixz="4E-08" iyy="0.00010327" iyz="0" izz="9.707E-05"/>
                    <geom class="gripper_visual" mesh="gripper_base_link"/>
                    <geom class="gripper_collision" mesh="gripper_base_link" material="black"/>   
                    <body name="right_finger_prox_link" pos="" quat=""/>
                      <initerial pos="" quat="" mass="0.018385"
                      diaginertia="" />
                      <origin rpy="0 0 0" xyz="0.020257 0.0063483 6.991E-05"/>
                      <inertia ixx="2.29E-06" ixy="1.43E-06" ixz="0" iyy="4.56E-06" iyz="0" izz="4.77E-06"/>
                      <!--TODO(Will) get correct classes for joints-->
                      <joint name="right_finger_bottom_joint" range="0.0 0.85"/>
                      <geom class="gripper_visual" mesh="right_finger_prox_link"/>
                      <geom class="gripper_collision" mesh="right_finger_prox_link" material="gray"/> 
                      <body name="right_finger_dist_link" pos="" quat=""/>
                        <initerial pos="" quat="" mass="0.010748"
                        diaginertia="" />
                        <origin rpy="0 0 0" xyz="0.018488 0.0011091 0"/>
                        <inertia ixx="6.3E-07" ixy="3.2E-07" ixz="0" iyy="1.83E-06" iyz="0" izz="1.61E-06"/>
                        <!--TODO(Will) get correct classes for joints-->
                        <joint name="right_finger_tip_joint" range="-0.50 0.21"/>
                        <geom class="gripper_visual" mesh="right_finger_dist_link"/>
                        <geom class="gripper_collision" mesh="right_finger_dist_link" material="gray"/>   
                        <!--TODO(Will) need to add friction from pad_box2-->
                      </body>
                    </body>
                    <body name="left_finger_prox_link" pos="" quat=""/>
                      <initerial pos="" quat="" mass="0.018385"
                      diaginertia="" />
                      <origin rpy="0 0 0" xyz="0.020257 0.0063483 6.99E-05"/>
                      <inertia ixx="2.29E-06" ixy="1.43E-06" ixz="0" iyy="4.56E-06" iyz="0" izz="4.77E-06"/>
                      <!--TODO(Will) get correct classes for joints-->
                      <joint name="left_finger_bottom_joint" range="0.0 0.85"/>
                      <geom class="gripper_visual" mesh="left_finger_prox_link"/>
                      <geom class="gripper_collision" mesh="left_finger_prox_link" material="gray"/> 
                      <body name="left_finger_dist_link" pos="" quat=""/>
                        <initerial pos="" quat="" mass="0.010748"
                        diaginertia="" />
                        <origin rpy="0 0 0" xyz="-0.018488 0.0011091 0"/>
                        <inertia ixx="6.3E-07" ixy="3.2E-07" ixz="0" iyy="1.83E-06" iyz="0" izz="1.61E-06"/>      
                        <!--TODO(Will) get correct classes for joints-->
                        <joint name="left_finger_tip_joint" range="-0.50 0.21"/>
                        <geom class="gripper_visual" mesh="left_finger_dist_link"/>
                        <geom class="gripper_collision" mesh="left_finger_dist_link" material="gray"/>   
                        <!--TODO(Will) need to add friction from pad_box2-->
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="gripper_base_link" body2="right_finger_prox_link"/>
    <exclude body1="gripper_base_link" body2="left_finger_prox_link"/>
    <exclude body1="right_finger_prox_link" body2="right_finger_dist_link"/>
    <exclude body1="left_finger_dist_link" body2="right_finger_dist_link"/>
  </contact>

  <tendon>
    <fixed name="fingers_actuator">
      <joint joint="right_finger_bottom_joint" coef="0.5"/>
      <joint joint="left_finger_bottom_joint" coef="0.5"/>
    </fixed>
  </tendon>   

  <equality>
    <!-- TODO(Will) check if these equality tags are needed
    <connect anchor="0 0 0" body1="right_follower" body2="right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="left_follower" body2="left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    -->
    <joint joint1="right_finger_bottom_joint" joint2="left_finger_bottom_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>  

  <actuator>
    <!-- Arm position actuators -->
    <!-- TODO(Will) see about adding control range-->
    <position class="large_actuator" name="joint_1" joint="joint_1"/>
    <position class="large_actuator" name="joint_2" joint="joint_2"/>
    <position class="large_actuator" name="joint_3" joint="joint_3"/>
    <position class="small_actuator" name="joint_4" joint="joint_4"/>
    <position class="small_actuator" name="joint_5" joint="joint_5"/>
    <position class="small_actuator" name="joint_6" joint="joint_6"/>

    <!-- Gripper: single tendon-based actuator
         ctrl=0 → open (driver joints at 0), ctrl=255 → closed (driver joints at 0.8).
         gainprm[0] = 0.8 * 100 / 255 ≈ 0.3137255, kp=100 via biasprm. -->
    <general class="gen3lite_2f" name="fingers_actuator" tendon="fingers_actuator" forcerange="-5 5" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>   

  <keyframe>
    <!-- 6 arm joints + 4 gripper joints-->
    <key name="home" qpos="0 0.26179939 3.14159265 -2.26892803 0 0.95993109 0 0 0 0"/>
    <key name="retract" qpos="0 -0.34906585 3.14159265 -2.54818071 0 -0.87266463 0 0 0 0"/>
  </keyframe>
                
</mujoco>
